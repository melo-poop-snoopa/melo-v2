# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GCP Cloud KMS
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCP_PROJECT_ID=melo
KMS_LOCATION=us-central1
KMS_KEY_RING=melo-keys
KMS_KEY_NAME=melo-camera-key

# Cloudflare R2
R2_BUCKET=melo-live-segments
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key

# Shelter identity
SHELTER_ID=your-shelter-uuid

# HLS (optional)
HLS_SEGMENT_DURATION=2
HLS_PLAYLIST_SIZE=5
HLS_OUTPUT_DIR=./segments
HLS_VIDEO_CODEC=libx264
HLS_PRESET=ultrafast
HLS_FPS=30

# Privacy filter
PRIVACY_FILTER_ENABLED=true
PRIVACY_CONFIDENCE_THRESHOLD=0.5

# Thumbnails — set R2_PUBLIC_BASE to enable (e.g. https://pub-abc.r2.dev)
THUMBNAIL_INTERVAL=30
R2_PUBLIC_BASE=

# Logging
LOG_LEVEL=INFO

# Setup API security
SETUP_API_TOKEN=
SETUP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Development
LOCAL_DEV=false
